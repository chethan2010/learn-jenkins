pipeline{
    agent{
      label 'AGENT-1'
    }
    options{

        timeout(time:2, unit: 'MINUTES')
        disableConcurrentBuilds()
    }
        stages{
            stage('build'){
              steps{  
                sh 'echo this is Build'
              }
           
            }
            stage('Test'){
                steps{
                  sh 'echo this is teast'
                  sh  'sleep 10'  
                }
            }
            stage('Deploy'){
                steps{
                  sh 'echo this is Deploy'  
                }
            }        
        }
            
    }