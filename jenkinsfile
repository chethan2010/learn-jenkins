pipeline {
    agent {
       label 'Agent-1'
    }
    options{
        timeout(time: 30, unit: 'MINUTES')
        disableConcurrentBuilds()
    }
    parameters {
        string(name: 'PERSON', defaultValue: 'John Doe', description: 'Hemanth')

        text(name: 'BIOGRAPHY', defaultValue: 'Write a short biography', description: 'Enter your biography')

        booleanParam(name: 'TOGGLE', defaultValue: true, description: 'Toggle this option')

        choice(name: 'CHOICE', choices: ['Option 1', 'Option 2', 'Option 3'], description: 'Choose an option')

        password(name: 'PASSWORD', defaultValue: '', description: 'Enter a password')
    }
    environment {
        DEPLOY_ENV = 'production'
        
    }
    stages {

        stage('build') {
            steps {
                sh 'echo this is Build'
            }
        }

        stage('Test') {
            steps {
                sh 'echo this is test'
                sh 'sleep 10'
            }
        }

        stage('Deploy') {
            steps {
                sh 'echo this is Deploy'
            }
        }

        // stage('pars') {
        //     steps {
        //         echo "Hello ${params.PERSON}"
        //         echo "Biography: ${params.BIOGRAPHY}"
        //         echo "Toggle: ${params.TOGGLE}"
        //         echo "Choice: ${params.CHOICE}"
        //         echo "Password: ${params.PASSWORD}"

        //         echo 'trigger test'

        //         error 'some failure'
        //     }
        // }
    }

    post {
        always {
            echo 'Hello says always again'
        }

        success {
            echo 'I will run when pipeline is success'
        }

        failure {
            echo 'I will run when pipeline is failure'
        }
    }
}